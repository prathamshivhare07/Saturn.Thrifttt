# ==============================================================================
# SATURN.THRIFTTT — ENVIRONMENT CONFIGURATION (TWILIO EMAIL OTP ENGINE)
# ==============================================================================

# Option 1: Twilio Verify API (Native Email Channel)
# Twilio Verify handles token generation, email delivery, expiration, and rate-limiting.
# Get credentials at: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid_here

# Option 2: Twilio SendGrid Email API
# Direct high-deliverability transactional email delivery via Twilio SendGrid.
# Get API Key from: https://app.sendgrid.com/settings/api_keys
TWILIO_SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM="Saturn Archive <vault@saturn.thrifttt>"

# ==============================================================================
# PAYMENTS CONFIGURATION
# ==============================================================================
# YouPI-PG Sovereign 0% Fee UPI Gateway (https://github.com/youpi-pg/YouPI-PG)
YOUPI_GATEWAY_URL=https://pay.yourdomain.com
YOUPI_MERCHANT_ID=your_youpi_merchant_uuid
YOUPI_UPI_VPA=saturn.thrift@okhdfcbank
VITE_YOUPI_UPI_VPA=saturn.thrift@okhdfcbank

# Stripe (Global Cards Vault)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here

# Razorpay (India UPI / Dynamic QR Rail)
